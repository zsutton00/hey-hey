    "lodash": "^4.17.21",
    "mermaid": "^11.12.3",
    "motion": "^12.19.2",
    "nuqs": "^2.6.0",
    "pluralize": "^8.0.0",
    "prismjs": "^1.30.0",
    "react-filepond": "^7.1.3",
    "react-hook-form": "^7.56.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.0.5",
    "reactflow": "^11.11.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18",
    "zod": "^3.25.30"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.81.5",
