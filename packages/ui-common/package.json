{
  "name": "@hey-hey/ui-common",
  "private": false,
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": [
    "src/utils/prismLanguage.ts",
    "dist/utils.mjs",
    "dist/utils.cjs",
    "dist/chunk-*.mjs",
    "dist/chunk-*.cjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./animations": {
      "types": "./src/animations/index.ts",
      "import": "./dist/animations.mjs",
      "require": "./dist/animations.cjs",
      "default": "./dist/animations.mjs"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./dist/api.mjs",
      "require": "./dist/api.cjs",
      "default": "./dist/api.mjs"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.cjs",
      "default": "./dist/components.mjs"
    },
    "./agent-sessions-runtime": {
      "types": "./src/components/AgentSession/runtime/index.ts",
      "import": "./dist/agent-sessions-runtime.mjs",
      "require": "./dist/agent-sessions-runtime.cjs",
      "default": "./dist/agent-sessions-runtime.mjs"
    },
    "./context": {
      "types": "./src/contexts/index.ts",
      "import": "./dist/context.mjs",
      "require": "./dist/context.cjs",
      "default": "./dist/context.mjs"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "import": "./dist/data.mjs",
      "require": "./dist/data.cjs",
      "default": "./dist/data.mjs"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.cjs",
      "default": "./dist/hooks.mjs"
    },
    "./clients": {
      "types": "./src/clients/index.ts",
      "import": "./dist/clients.mjs",
      "require": "./dist/clients.cjs",
      "default": "./dist/clients.mjs"
    },
    "./agents": {
      "types": "./src/agents/index.ts",
      "import": "./dist/agents.mjs",
      "require": "./dist/agents.cjs",
      "default": "./dist/agents.mjs"
    },
    "./agents-prompts": {
      "types": "./src/agents/prompts.ts",
      "import": "./dist/agents-prompts.mjs",
      "require": "./dist/agents-prompts.cjs",
      "default": "./dist/agents-prompts.mjs"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./dist/services.mjs",
      "require": "./dist/services.cjs",
      "default": "./dist/services.mjs"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./dist/i18n.mjs",
      "require": "./dist/i18n.cjs",
      "default": "./dist/i18n.mjs"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs",
      "default": "./dist/utils.mjs"
    },
    "./permissions": {
      "types": "./src/permissions/index.ts",
      "import": "./dist/permissions.mjs",
      "require": "./dist/permissions.cjs",
      "default": "./dist/permissions.mjs"
    },
    "./capability-catalog": {
      "types": "./src/components/AgentSession/capabilityCatalog.ts",
      "import": "./dist/capability-catalog.mjs",
      "require": "./dist/capability-catalog.cjs",
      "default": "./dist/capability-catalog.mjs"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @hey-hey/ui-common-playground dev",
    "check": "pnpm lint && pnpm type-check && pnpm test:run",
    "prebuild": "pnpm lint && pnpm type-check",
    "build": "node scripts/run-tsup-with-heap.cjs",
    "fix:api": "node scripts/openapi-post.js",
    "type-check": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "preview": "pnpm --filter @hey-hey/ui-common-playground preview",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main --passWithNoTests",
    "test:file": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:browser:project-report": "pnpm tsc --noEmit -p scripts/browser/tsconfig.json && node scripts/verify-project-report-browser.mjs",
    "clean:api": "rm -rf src/api src/local-agent-api/generated src/generated",
    "generate:contract": "node \"$(node scripts/openapi-root.cjs)/scripts/task-monitor-contract.js\" --typescript-output src/generated/task-monitor-contract.schema.ts",
    "generate:entity-prompt-template-language": "node scripts/generate-entity-prompt-template-language.cjs",
    "generate:api": "pnpm generate:contract && pnpm generate:entity-prompt-template-language && openapi-generator-cli generate -i \"$(node scripts/openapi-root.cjs)/specs/api/openapi.yaml\" -g typescript-axios -o src/api --additional-properties=npmName=hey-hey-api,supportsES6=true,withInterfaces=true,modelPropertyNaming=camelCase,typescriptThreePlus=true,useSingleRequestParameter=true --global-property=apiDocs=false,modelDocs=false && node \"$(node scripts/openapi-root.cjs)/scripts/postprocess-project-report-models.js\" src/api/api.ts && node scripts/generate-private-beta-access-contract.cjs && node scripts/generate-browser-session-contract.cjs && node scripts/generate-activity-history-contract.cjs && node scripts/generate-open-items-contract.cjs && node scripts/align-cli-source-types.cjs",
    "generate:all": "pnpm clean:api && pnpm generate:api && pnpm generate:local",
    "generate:check": "pnpm generate:all",
    "verify:deploy": "pnpm generate:all && pnpm build && pnpm test:run",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --verbose",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "pnpm build && changeset publish --dry-run",
    "generate:i18n-keys": "node scripts/generate-i18n-keys.cjs",
    "analyze:openapi": "tsx scripts/schema-analysis/parse-openapi.ts",
    "analyze:prisma": "tsx scripts/schema-analysis/parse-prisma.ts",
    "analyze:relationships": "tsx scripts/schema-analysis/detect-relationships.ts",
    "generate:relationship-config": "tsx scripts/schema-analysis/generate-config.ts",
    "validate:relationship-config": "tsx scripts/schema-analysis/validate-config-cli.ts",
    "generate:local": "tmp=\"$(mktemp -d \"${TMPDIR:-/tmp}/openapi-generate.XXXXXX\")\" && trap 'rm -rf \"$tmp\"' EXIT && openapi-generator-cli generate -i \"$(node scripts/openapi-root.cjs)/specs/local/openapi.yaml\" -g typescript-axios -o \"$tmp\" --additional-properties=supportsES6=true,withInterfaces=true,modelPropertyNaming=camelCase,typescriptThreePlus=true,useSingleRequestParameter=true --global-property=apiDocs=false,modelDocs=false && mkdir -p src/local-agent-api/generated && cp \"$tmp/api.ts\" \"$tmp/base.ts\" \"$tmp/common.ts\" \"$tmp/configuration.ts\" \"$tmp/index.ts\" src/local-agent-api/generated/ && node scripts/clean-generated-api-imports.cjs src/local-agent-api/generated/api.ts && pnpm exec prettier --write src/local-agent-api/generated",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
