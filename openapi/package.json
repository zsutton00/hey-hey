{
  "name": "hey-hey-openapi",
  "version": "1.0.0",
  "description": "OpenAPI specifications and generated clients for hey-hey services",
  "main": "index.js",
  "scripts": {
    "validate:feature-sync-decision-contract": "node scripts/validate-feature-sync-decision-contract.js",
    "validate:api": "npx @apidevtools/swagger-cli validate specs/api/openapi.yaml",
    "validate:embeddings": "npx @apidevtools/swagger-cli validate specs/embeddings/openapi.yaml",
    "validate:graphs": "npx @apidevtools/swagger-cli validate specs/graphs/openapi.yaml",
    "validate:agents": "npx @apidevtools/swagger-cli validate specs/agents/openapi.yaml",
    "validate:agent-bridge": "npx @apidevtools/swagger-cli validate specs/agent-bridge/openapi.yaml",
    "validate:local": "npx @apidevtools/swagger-cli validate specs/local/openapi.yaml",
    "validate:eval-run-contract": "node scripts/validate-eval-run-contract.js",
    "validate:workflow-edge-contract": "node scripts/validate-workflow-edge-contract.js",
    "validate:workflow-start-run-contract": "node scripts/validate-workflow-start-run-contract.js",
    "validate:repository-grounding-contract": "node scripts/validate-repository-grounding-contract.js",
    "validate:fast-mode-contract": "node scripts/validate-fast-mode-contract.js",
    "validate:session-monitor-report-guidance-contract": "node scripts/validate-session-monitor-report-guidance-contract.js",
    "validate:controller-authorization-contract": "node scripts/validate-controller-authorization-contract.js",
    "generate:repository-feature-enrichment-runtime-schema": "node scripts/generate-repository-feature-enrichment-runtime-schema.js generated/repository-feature-enrichment-runtime-schema.ts",
    "validate:project-mode-contract": "node scripts/project-mode-contract.js",
    "check-operation-metadata": "node scripts/validate-operation-metadata.js",
    "validate:projection-deletion-contract": "node scripts/validate-projection-deletion-contract.js",
    "validate:all": "npm run validate:api && npm run validate:embeddings && npm run validate:graphs && npm run validate:agents && npm run validate:agent-bridge && npm run validate:local && npm run validate:eval-run-contract && npm run validate:workflow-start-run-contract && npm run validate:fast-mode-contract && npm run validate:session-monitor-report-guidance-contract && npm run validate:controller-authorization-contract && npm run validate:repository-grounding-contract && npm run validate:project-mode-contract && npm run check-operation-metadata && npm run validate:projection-deletion-contract",
    "check-duplicates": "node shared/validate-duplicates.js",
    "analyze:unused": "node scripts/find-unused-spec-content.js",
    "remove:unused": "node scripts/remove-unused-spec-content.js",
    "measure:generation": "node scripts/measure-spec-generation.js",
    "bundle:api": "npx @apidevtools/swagger-cli bundle specs/api/openapi.yaml -o generated/api-bundled.yaml",
    "bundle:embeddings": "npx @apidevtools/swagger-cli bundle specs/embeddings/openapi.yaml -o generated/embeddings-bundled.yaml",
    "generate:typescript": "npm run generate:typescript:api && npm run generate:typescript:embeddings",
    "generate:typescript:api": "npx @openapitools/openapi-generator-cli generate -i specs/api/openapi.yaml -g typescript-axios -o generated/clients/typescript/api --additional-properties=npmName=@hey-hey/api-client,npmVersion=1.0.0,useSingleRequestParameter=true",
    "generate:typescript:embeddings": "npx @openapitools/openapi-generator-cli generate -i specs/embeddings/openapi.yaml -g typescript-axios -o generated/clients/typescript/embeddings --additional-properties=npmName=@hey-hey/embeddings-client,npmVersion=1.0.0,useSingleRequestParameter=true",
    "generate:typescript:graphs": "npx @openapitools/openapi-generator-cli generate -i specs/graphs/openapi.yaml -g typescript-axios -o generated/clients/typescript/graphs --additional-properties=npmName=@hey-hey/graphs-client,npmVersion=1.0.0,useSingleRequestParameter=true",
    "generate:python": "npm run generate:python:api && npm run generate:python:embeddings",
    "generate:python:api": "npx @openapitools/openapi-generator-cli generate -i specs/api/openapi.yaml -g python -o generated/clients/python/api --additional-properties=packageName=hey_hey_api_client,packageVersion=1.0.0",
    "generate:python:embeddings": "npx @openapitools/openapi-generator-cli generate -i specs/embeddings/openapi.yaml -g python -o generated/clients/python/embeddings --additional-properties=packageName=hey_hey_embeddings_client,packageVersion=1.0.0",
    "generate:java:graphs": "npx @openapitools/openapi-generator-cli generate -i specs/graphs/openapi.yaml -g java -o generated/clients/java/graphs --additional-properties=artifactId=hey-hey-graphs-client,artifactVersion=1.0.0,invokerPackage=com.heyhey.graphs.client,apiPackage=com.heyhey.graphs.client.api,modelPackage=com.heyhey.graphs.client.model",
    "generate:projection-deletion": "npm run generate:typescript:api && npm run generate:typescript:embeddings && npm run generate:typescript:graphs && npm run generate:python:embeddings && npm run generate:java:graphs",
    "generate:all": "npm run generate:typescript && npm run generate:python",
    "lint": "npx @apidevtools/swagger-cli validate specs/api/openapi.yaml specs/embeddings/openapi.yaml specs/agent-bridge/openapi.yaml specs/local/openapi.yaml",
    "test": "npm run validate:all",
    "docs": "npx redoc-cli build specs/api/openapi.yaml --output docs/api.html && npx redoc-cli build specs/embeddings/openapi.yaml --output docs/embeddings.html && npx redoc-cli build specs/agent-bridge/openapi.yaml --output docs/agent-bridge.html",
    "serve:docs:api": "npx redoc-cli serve specs/api/openapi.yaml",
    "serve:docs:embeddings": "npx redoc-cli serve specs/embeddings/openapi.yaml",
    "serve:docs:agent-bridge": "npx redoc-cli serve specs/agent-bridge/openapi.yaml",
    "watch": "npx @apidevtools/swagger-cli validate specs/api/openapi.yaml specs/embeddings/openapi.yaml --watch",
    "precommit": "npm run check-duplicates"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "client-generation",
    "microservices"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.3",
    "redoc-cli": "^0.13.21",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@redocly/cli": "^1.34.3",
    "axios": "^1.6.0"
  }
}
