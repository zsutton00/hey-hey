{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@hey-hey/contracts/api": ["../../packages/contracts/dist/cjs/generated/api/index.d.ts"],
      "@hey-hey/contracts/api/models": ["../../packages/contracts/dist/cjs/generated/api/models/index.d.ts"],
      "@hey-hey/contracts/api/*": ["../../packages/contracts/dist/cjs/generated/api/*.d.ts"],
      "@hey-hey/contracts/agent-bridge": ["../../packages/contracts/dist/cjs/generated/agent-bridge/index.d.ts"],
      "@hey-hey/contracts/agent-bridge/models": ["../../packages/contracts/dist/cjs/generated/agent-bridge/models/index.d.ts"],
      "@hey-hey/contracts/agent-bridge/runtime-schema": ["../../packages/contracts/dist/cjs/generated/agent-bridge/repository-feature-enrichment-runtime-schema.d.ts"],
      "@hey-hey/contracts/agent-bridge/*": ["../../packages/contracts/dist/cjs/generated/agent-bridge/*.d.ts"],
      "@hey-hey/contracts/local": ["../../packages/contracts/dist/cjs/generated/local/index.d.ts"],
      "@hey-hey/contracts/local/models": ["../../packages/contracts/dist/cjs/generated/local/models/index.d.ts"],
      "@hey-hey/contracts/local/*": ["../../packages/contracts/dist/cjs/generated/local/*.d.ts"],
      "@hey-hey/contracts/brands": ["../../packages/contracts/dist/cjs/brands.d.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
