{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@hey-hey/contracts/api": ["../../packages/contracts/dist/cjs/generated/api/index"],
      "@hey-hey/contracts/api/models": [
        "../../packages/contracts/dist/cjs/generated/api/models/index"
      ],
      "@hey-hey/contracts/api/*": ["../../packages/contracts/dist/cjs/generated/api/*"],
      "@hey-hey/contracts/agent-bridge": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/index"
      ],
      "@hey-hey/contracts/agent-bridge/models": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/models/index"
      ],
      "@hey-hey/contracts/agent-bridge/runtime-schema": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/repository-feature-enrichment-runtime-schema"
      ],
      "@hey-hey/contracts/agent-bridge/*": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/*"
      ],
      "@hey-hey/contracts/local": ["../../packages/contracts/dist/cjs/generated/local/index"],
      "@hey-hey/contracts/local/models": [
        "../../packages/contracts/dist/cjs/generated/local/models/index"
      ],
      "@hey-hey/contracts/local/*": ["../../packages/contracts/dist/cjs/generated/local/*"],
      "@hey-hey/contracts/brands": ["../../packages/contracts/dist/cjs/brands"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
