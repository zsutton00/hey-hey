{
  "name": "@hey-hey/cli",
  "version": "4.4.1",
  "description": "Hey Hey Agent Bridge — a local CLI that runs agent coding sessions and bridges the Hey Hey platform with Claude Code.",
  "main": "dist/index.mjs",
  "bin": {
    "heyhey": "dist/index.mjs"
  },
  "files": [
    "dist",
    "release-manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsutton00/cli.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Zac Sutton",
  "scripts": {
    "dev": "pnpm dev:run",
    "dev:build": "node scripts/build.mjs --watch",
    "build": "node ../../scripts/generate-contracts.mjs --with-lock --build-contracts --target=cli -- pnpm --dir apps/cli run build:unlocked",
    "typecheck": "node ../../scripts/generate-contracts.mjs --with-lock --build-contracts --target=cli -- pnpm --dir apps/cli exec tsc --noEmit",
    "register": "pnpm run build && pnpm link --global",
    "unregister": "pnpm unlink --global",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.package.config.ts",
    "dev:run": "NODE_ENV=production tsx src/index.tsx",
    "debug": "NODE_ENV=production node --inspect-brk --import tsx src/index.tsx --local",
    "eval:project-assistant": "tsx evals/project-assistant/src/run.ts",
    "eval:project-assistant:capture": "tsx evals/project-assistant/src/capture.ts",
    "eval:project-assistant:baseline": "tsx evals/project-assistant/src/provision-environment.ts --environment baseline",
    "eval:project-assistant:baseline:refresh": "tsx evals/project-assistant/src/provision-environment.ts --environment baseline --refresh",
    "eval:project-assistant:candidate:reset": "tsx evals/project-assistant/src/provision-environment.ts --environment candidate",
    "eval:project-assistant:archive": "tsx evals/project-assistant/src/archive-latest.ts",
    "eval:project-assistant:view": "tsx evals/project-assistant/viewer/server.ts",
    "eval:contract-anchor": "tsx evals/contract-anchor/src/run.ts",
    "eval:work-item-scope": "tsx evals/work-item-scope/src/run.ts",
    "eval:jev-relevance": "tsx evals/jev-relevance/src/run.ts",
    "eval:jev-relevance:capture": "tsx evals/jev-relevance/src/capture.ts",
    "eval:jev-relevance:edges-capture": "tsx evals/jev-relevance/src/edges-capture.ts",
    "eval:jev-relevance:read-check": "tsx evals/jev-relevance/src/read-check-run.ts",
    "eval:jev-relevance:read-check-capture": "tsx evals/jev-relevance/src/read-check-capture.ts",
    "eval:jev-relevance:run-transcript": "tsx evals/jev-relevance/src/run-transcript.ts",
    "eval:jev-relevance:hints-capture": "tsx evals/jev-relevance/src/hints-capture.ts",
    "eval:jev-relevance:decisions-capture": "tsx evals/jev-relevance/src/decisions-capture.ts",
    "eval:jev-relevance:view": "tsx evals/jev-relevance/viewer/server.ts",
    "eval:diagram-links": "tsx evals/diagram-links/src/run.ts",
    "eval:entity-conversation-research": "tsx evals/entity-conversation-research/src/run.ts",
    "openapi:context": "node scripts/openapi-root.cjs --context",
    "openapi:doctor": "node scripts/openapi-root.cjs --doctor",
    "cleanup:invalid-runs": "tsx src/scripts/delete-invalid-runs.ts",
    "cleanup:run-store": "tsx src/scripts/cull-run-store.ts",
    "migrate:run-store": "tsx src/scripts/migrate-run-store.ts",
    "probe:project-mode-launch-resume": "tsx src/scripts/probe-project-mode-launch-resume.ts",
    "codex:skills": "tsx src/scripts/list-codex-skills.ts",
    "jev:scenarios": "tsx src/scripts/jev-scenarios.ts",
    "generate:contract": "node ../../scripts/generate-contracts.mjs --target=cli",
    "generate:local": "node ../../scripts/generate-contracts.mjs --target=contracts-local",
    "generate:agent-bridge": "node ../../scripts/generate-contracts.mjs --target=contracts-agent-bridge",
    "generate:api": "node ../../scripts/generate-contracts.mjs --target=contracts-api",
    "generate": "node ../../scripts/generate-contracts.mjs --target=cli",
    "generate:all": "node ../../scripts/generate-contracts.mjs --target=cli",
    "generate:check": "node ../../scripts/generate-contracts.mjs --check --target=cli",
    "prepack": "tsx scripts/verify-release-manifest.ts && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "codex:smoke": "tsx scripts/codex-smoke.ts",
    "generate:contract:unlocked": "node ../../scripts/require-openapi-staging.cjs && node scripts/generate-custom-contracts.cjs",
    "generate:all:unlocked": "node ../../scripts/require-openapi-staging.cjs && node scripts/generate-custom-contracts.cjs",
    "build:unlocked": "node scripts/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@napi-rs/keyring": "^1.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ccusage": "20.0.20",
    "playwright-core": "^1.64.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "2.29.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "axios": "1.16.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.2.1",
    "fuse.js": "^7.3.0",
    "ignore": "^7.0.5",
    "ink": "6.8.0",
    "ink-testing-library": "4.0.0",
    "jsonrepair": "^3.14.0",
    "open": "^11.0.0",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "6.4.2",
    "vitest": "^4.1.7",
    "zod": "^3.25.76",
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
