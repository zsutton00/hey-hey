GRAPH_SEARCH_DATABASE_URL=postgres://graph_search:replace_me@127.0.0.1:5432/heyhey_graph_search
GRAPH_SEARCH_BIND=127.0.0.1:8090
GRAPH_SEARCH_MAX_CONNECTIONS=5
GRAPH_ENABLED=true
SEARCH_ENABLED=true
SEARCH_EMBEDDING_MODEL_DIR=models/snowflake-arctic-embed-s
RUST_LOG=info

# Required API signing trust; no static-secret or unsigned fallback.
GRAPH_SEARCH_JWKS_URL=http://host.docker.internal:3000/api/v1/auth/jwks
GRAPH_SEARCH_GRAPH_AUDIENCE=graph-service
GRAPH_SEARCH_SEARCH_AUDIENCE=embeddings-service
# Leave unset for current API tokens, which omit issuer and user audience.
# GRAPH_SEARCH_JWT_ISSUER=
# GRAPH_SEARCH_USER_AUDIENCE=
