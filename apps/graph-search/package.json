{
  "name": "@hey-hey/graph-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cargo build --locked --release",
    "start": "cargo run --locked",
    "type-check": "cargo check --locked --all-targets",
    "lint": "cargo fmt --all --check && cargo clippy --locked --all-targets -- -D warnings",
    "test": "cargo test --locked",
    "test:database": "cargo test --locked --test database -- --ignored --test-threads=1",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "test:container": "bash scripts/test-container.sh"
  }
}
