# UI container runtime
PORT=5173
LOG_LEVEL=info

# Browser API endpoint configuration
API_PROTOCOL=http
API_HOST=localhost
API_PORT=3000
API_BASE_PATH=/api/v1

# Optional explicit overrides
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_WS_URL=ws://localhost:3000
# VITE_ENV=production

# Public site key for the demo bot-check widget (Cloudflare Turnstile)
# VITE_BOT_CHECK_SITE_KEY=

# Optional *_FILE mounted secret support
# API_HOST_FILE=/run/secrets/ui_api_host
# API_PORT_FILE=/run/secrets/ui_api_port
# VITE_API_URL_FILE=/run/secrets/ui_api_url

# Public landing analytics; empty disables tracking
# VITE_GOATCOUNTER_ENDPOINT=https://YOUR-SITE.goatcounter.com/count
