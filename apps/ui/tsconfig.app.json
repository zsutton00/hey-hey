{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "disableSourceOfProjectReferenceRedirect": true,

    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@hey-hey/ui-common": ["./.worktree-links/ui-common/src/index.ts"],
      "@hey-hey/ui-common/animations": [
        "./.worktree-links/ui-common/src/animations/index.ts"
      ],
      "@hey-hey/ui-common/api": ["./.worktree-links/ui-common/src/api/index.ts"],
      "@hey-hey/ui-common/components": [
        "./.worktree-links/ui-common/src/components/index.ts"
      ],
      "@hey-hey/ui-common/components/*": [
        "./.worktree-links/ui-common/src/components/*"
      ],
      "@hey-hey/ui-common/feature-tree-visualization": [
        "./.worktree-links/ui-common/src/components/Features/FeatureTreeVisualization.tsx"
      ],
      "@hey-hey/ui-common/agent-sessions-runtime": [
        "./.worktree-links/ui-common/src/components/AgentSession/runtime/index.ts"
      ],
      "@hey-hey/ui-common/context": [
        "./.worktree-links/ui-common/src/contexts/index.ts"
      ],
      "@hey-hey/ui-common/data": [
        "./.worktree-links/ui-common/src/data/index.ts"
      ],
      "@hey-hey/ui-common/hooks": [
        "./.worktree-links/ui-common/src/hooks/index.ts"
      ],
      "@hey-hey/ui-common/clients": [
        "./.worktree-links/ui-common/src/clients/index.ts"
      ],
      "@hey-hey/ui-common/agents": [
        "./.worktree-links/ui-common/src/agents/index.ts"
      ],
      "@hey-hey/ui-common/agents-prompts": [
        "./.worktree-links/ui-common/src/agents/prompts.ts"
      ],
      "@hey-hey/ui-common/services": [
        "./.worktree-links/ui-common/src/services/index.ts"
      ],
      "@hey-hey/ui-common/services/*": [
        "./.worktree-links/ui-common/src/services/*"
      ],
      "@hey-hey/ui-common/i18n": [
        "./.worktree-links/ui-common/src/i18n/index.ts"
      ],
      "@hey-hey/ui-common/utils": [
        "./.worktree-links/ui-common/src/utils/index.ts"
      ],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": [
        "./node_modules/@types/react/jsx-dev-runtime.d.ts"
      ]
    }
  },
  "references": [
    { "path": ".worktree-links/ui-common/tsconfig.api.json" }
  ],
  "include": [
    "src/components/**/*",
    "src/_contexts/**/*",
    "src/hooks/**/*",
    "src/pages/**/*",
    "src/services/**/*",
    "src/types/**/*",
    "src/clients/client.ts",
    "src/clients/index.ts",
    "src/clients/serviceClients.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/App.css",
    "src/index.css",
    "src/theme.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": ["src/**/*.test.ts*", "src/**/__tests__/**/*"]
}
