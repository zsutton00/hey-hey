{
  "name": "hey-hey",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "link:worktree-dependencies": "node scripts/link-worktree-dependencies.mjs",
    "dev": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vite",
    "dev:prod": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common VITE_API_PROXY_TARGET=https://heyhey.dev VITE_API_URL=/api/v1 vite --port 5174",
    "dev:staging": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common VITE_API_PROXY_TARGET=https://staging.heyhey.dev VITE_API_URL=/api/v1 vite --port 5174",
    "build": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vite build",
    "build:container": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vite build",
    "type-check": "pnpm link:worktree-dependencies && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "preview": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vite preview",
    "docker:build": "docker build --build-context ui_common=../ui-common --build-arg APP_VERSION=local -t hey-hey-ui:local .",
    "docker:compose:ui": "docker compose --profile ui up --build ui",
    "test": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vitest run && node --test scripts/runtime-model-catalog.test.mjs",
    "test:ui": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vitest --ui",
    "test:run": "pnpm link:worktree-dependencies && HEY_HEY_UI_COMMON_ROOT=.worktree-links/ui-common vitest run && node --test scripts/runtime-model-catalog.test.mjs",
    "generate:i18n-keys": "node scripts/generate-i18n-keys.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hey-hey/ui-common": "file:../ui-common",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/styles": "^6.4.8",
    "@mui/system": "^7.1.0",
    "@mui/x-charts": "^8.27.0",
    "@mui/x-date-pickers": "^8.11.1",
    "@tanstack/react-query": "^5.81.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.21",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "i18next": "^25.3.0",
    "jotai": "^2.13.1",
    "jotai-tanstack-query": "^0.11.0",
    "motion": "^12.19.2",
    "nuqs": "^2.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.5.3",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest-websocket-mock": "^2.5.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "msw": "^2.11.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
