  @@index([nextAttemptAt, createdAt], map: "agent_operation_dispatch_pending_idx")
  @@index([claimExpiresAt], map: "agent_operation_dispatch_lease_idx")
  @@index([grantId], map: "agent_operation_dispatches_grant_id_idx")
