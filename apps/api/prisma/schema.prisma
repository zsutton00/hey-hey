  updatedAt            DateTime @updatedAt @map("updated_at")

  agentSession       AgentSession             @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  interactionAttempt AgentInteractionAttempt? @relation(fields: [interactionAttemptId], references: [id], onDelete: Restrict)

  @@unique([agentSessionId, ordinal])
  @@unique([agentSessionId, idempotencyKey])
  @@index([agentSessionId, state, ordinal])
  @@map("agent_session_turn_admissions")
}

model AgentOperation {
  operationId             String                           @id @map("operation_id") @db.Uuid
  organizationId          String                           @map("organization_id")
  projectId               String                           @map("project_id")
  userId                  String                           @map("user_id")
  agentSessionId          String                           @map("agent_session_id")
  conversationId          String                           @map("conversation_id")
