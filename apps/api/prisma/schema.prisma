  projectId                     String           @map("project_id")
  type                          ProposalType     @default(SINGLE)
  action                        ProposalAction
  status                        ProposalStatus   @default(DRAFT)
  targetEntityId                String           @map("target_entity_id")
  targetEntityType              TargetEntityType @map("target_entity_type")
  updates                       Json
  title                         String?
  eli5                          String?          @db.VarChar(150)
  requestorId                   String           @map("requestor_id")
  requestorContext              Json?            @map("requestor_context")
  influences                    Json?
  edges                         Json?
  generatedWithVersion          String?          @map("generated_with_version")
  validationSessionId           String?          @map("validation_session_id")
  conversationId                String?          @map("conversation_id")
  messageId                     String?          @map("message_id")
  ragEnabled                    Boolean          @default(true) @map("rag_enabled")
  applicationEligible           Boolean          @default(true) @map("application_eligible")
  retainedOriginalTargetContent Json?            @map("retained_original_target_content")
  targetLastAppliedProposalId   String?          @map("target_last_applied_proposal_id") @db.Uuid
  createdAt                     DateTime         @default(now()) @map("created_at")
  updatedAt                     DateTime         @updatedAt @map("updated_at")

  organization                     Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                          Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  validationSession                ValidationSession?                @relation(fields: [validationSessionId], references: [id], onDelete: SetNull)
  conversation                     Conversation?                     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message                          Message?                          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  pendingEdgesAsSource             PendingProposalEdge[]             @relation("PendingEdgeSource")
  pendingEdgesAsTarget             PendingProposalEdge[]             @relation("PendingEdgeTarget")
  approvalRecords                  ProposalApprovalRecord[]
  trackingCleanupOperations        TrackingCleanupOperation[]
  cascadeExecution                 WorkItemTypeCascadeExecution?
  workItemChangeSetMaterialization WorkItemChangeSetMaterialization?
  groupMembership                  ProposalGroupMember?
  messageReferences                MessageProposalReference[]
  reconciliationRevisions          ProposalReconciliationRevision[]

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@index([targetEntityId, targetEntityType])
  @@index([validationSessionId])
  @@index([conversationId])
  @@index([messageId])
  @@index([requestorId])
  @@map("proposals")
}

