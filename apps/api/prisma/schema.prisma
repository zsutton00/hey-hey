  enrollment PendingMachineEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([userId, attemptedAt], map: "machine_enrollment_claim_failures_user_attempted_idx")
  @@index([sourceAddress, attemptedAt], map: "machine_enrollment_claim_failures_source_attempted_idx")
  @@index([enrollmentId, attemptedAt], map: "machine_enrollment_claim_failures_enrollment_attempted_idx")
  @@map("machine_enrollment_claim_failures")
}

