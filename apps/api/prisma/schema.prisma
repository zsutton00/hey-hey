// One prepared, exact action. `canonicalIntent` is the RFC 8785 serialization
// of the non-executable intent fields only; executable payloads and WebAuthn
// assertion material are deliberately absent from this model.
model ExecutionAuthorization {
  id                       String                         @id @default(uuid()) @map("authorization_id")
  requestId                String                         @map("request_id") @db.Uuid
  canonicalIntent          String                         @map("canonical_intent") @db.Text
