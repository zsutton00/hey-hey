  @@index([nextAttemptAt, createdAt], map: "agent_operation_workflow_input_pending_idx")
  @@index([claimExpiresAt], map: "agent_operation_workflow_input_lease_idx")
  @@map("agent_operation_workflow_input_deliveries")
}

enum AgentOperationDispatchState {
  PENDING
  CLAIMED
  ACKNOWLEDGED
  REJECTED

  @@map("agent_operation_dispatch_state")
}

model AgentOperationDispatch {
  operationId       String                          @id @map("operation_id") @db.Uuid
  authorizationId   String                          @map("authorization_id")
  authorizationKind AgentOperationAuthorizationKind @map("authorization_kind")
  grantId           String                          @map("grant_id")
  machineId         String                          @map("machine_id")
  triggerMessageId  String                          @unique @map("trigger_message_id")
  state             AgentOperationDispatchState     @default(PENDING)
