/// Durable receipt for explicit UI-to-CLI monitor commands. The public API
/// intentionally exposes submission only; this row exists to pin retry
/// identity and machine routing, re-fan queued commands after reconnect, and
/// retain the terminal CLI admission acknowledgement across API restarts.
model MonitorCommand {
  id              String    @id @default(uuid())
  requestId       String    @map("request_id")
  authorizationId String?   @map("authorization_id") @db.Uuid
  authorization   Json?
  organizationId  String    @map("organization_id")
  projectId       String    @map("project_id")
  monitorId       String    @map("monitor_id")
  userId          String    @map("user_id")
  machineId       String    @map("machine_id")
  body            Json
  expiresAt       DateTime  @map("expires_at")
  deliveryState   String    @default("QUEUED") @map("delivery_state")
  outcome         Json?
  attemptCount    Int       @default(0) @map("attempt_count")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitor      Task         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine      Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([machineId, deliveryState, expiresAt])
  @@index([monitorId, createdAt])
  @@map("monitor_commands")
}

