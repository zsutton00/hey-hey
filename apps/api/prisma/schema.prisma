  state                   AgentOperationState              @default(CREATED)
  authorizationId         String?                          @map("authorization_id") @db.Uuid
  authorizationKind       AgentOperationAuthorizationKind? @map("authorization_kind")
  grantId                 String?                          @map("grant_id")
  messageId               String?                          @map("message_id")
  triggerMessageId        String?                          @map("trigger_message_id")
  result                  Json?
  failureCode             String?                          @map("failure_code")
  failureMessage          String?                          @map("failure_message")
  executionOwner          String?                          @map("execution_owner") @db.Uuid
  executionLeaseExpiresAt DateTime?                        @map("execution_lease_expires_at")
  version                 Int                              @default(1)
  createdAt               DateTime                         @default(now()) @map("created_at")
  updatedAt               DateTime                         @updatedAt @map("updated_at")
  terminalAt              DateTime?                        @map("terminal_at")

  organization   Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSession   AgentSession                         @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
