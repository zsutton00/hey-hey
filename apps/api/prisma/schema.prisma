// Durable WebAuthn controller authority. The machine credential itself stays
// on Machine.tokenHash as a SHA-256 digest; this row stores only the public
// controller evidence and the consumed enrollment that activated it.
model MachineControllerCredential {
  id                       String    @id @default(uuid())
  machineId                String    @map("machine_id")
  userId                   String    @map("user_id")
  organizationId           String    @map("organization_id")
  controllerInstallationId String?   @map("controller_installation_id") @db.Uuid
  credentialId             String    @unique @map("credential_id")
  credentialPublicKeyX     Bytes     @map("credential_public_key_x")
  credentialPublicKeyY     Bytes     @map("credential_public_key_y")
  credentialTransports     String[]  @default([]) @map("credential_transports")
  credentialAaguid         Bytes?    @map("credential_aaguid")
  credentialSignCount      Int       @map("credential_sign_count")
  credentialBackupEligible Boolean   @map("credential_backup_eligible")
  credentialBackupState    Boolean   @map("credential_backup_state")
  controllerLabel          String    @map("controller_label")
  credentialFingerprint    String    @map("credential_fingerprint") @db.VarChar(64)
  createdAt                DateTime  @default(now()) @map("created_at")
  lastUsedAt               DateTime? @map("last_used_at")
  revokedAt                DateTime? @map("revoked_at")
  enrollmentId             String    @unique @map("enrollment_id")

  machine                   Machine                    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment                PendingMachineEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  executionAuthorizations   ExecutionAuthorization[]
  executionGrants           ExecutionGrant[]
  controllerBrowserBindings ControllerBrowserBinding[]

  @@index([machineId, revokedAt], map: "machine_controller_credentials_machine_revoked_at_idx")
  @@index([userId, revokedAt], map: "machine_controller_credentials_user_revoked_at_idx")
  @@index([organizationId, revokedAt], map: "machine_controller_credentials_organization_revoked_at_idx")
  @@index([controllerInstallationId, machineId, revokedAt], map: "machine_controller_credentials_installation_machine_revoked_idx")
  @@map("machine_controller_credentials")
}

model ControllerBrowserBinding {
  id                       String    @id @default(uuid()) @db.Uuid
  credentialHash           String    @unique @map("credential_hash") @db.VarChar(64)
