  @@index([projectId])
  @@index([conversationId])
  @@index([machineId])
  @@index([organizationId, entityType, entityId, updatedAt], map: "agent_sessions_org_entity_updated_idx")
  @@index([serviceId])
  @@index([providerAgentSessionId])
  @@map("agent_sessions")
