// This row reserves the API-owned machine identifier before a Machine row is
// created. `machineId` is intentionally unique but has no foreign key: local
// confirmation creates the Machine row with this same identifier atomically.
model PendingMachineEnrollment {
  id                            String                    @id @default(uuid())
  machineId                     String                    @map("machine_id")
  machinePublicKey              String                    @map("machine_public_key")
  machinePublicKeyFingerprint   String                    @map("machine_public_key_fingerprint") @db.VarChar(64)
  machineName                   String                    @map("machine_name")
  osFamily                      MachineEnrollmentOsFamily @map("os_family")
  cliVersion                    String                    @map("cli_version")
  authorizationProtocolVersion  Int                       @map("authorization_protocol_version")
  userCodeHmac                  String                    @unique @map("user_code_hmac") @db.VarChar(64)
  deviceSecretDigest            String                    @unique @map("device_secret_digest") @db.VarChar(64)
  state                         MachineEnrollmentState    @default(PENDING)
  failureCount                  Int                       @default(0) @map("failure_count")
  expiresAt                     DateTime                  @map("expires_at")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  browserClaimedAt              DateTime?                 @map("browser_claimed_at")
  awaitingMachineConfirmationAt DateTime?                 @map("awaiting_machine_confirmation_at")
  activatedAt                   DateTime?                 @map("activated_at")
  expiredAt                     DateTime?                 @map("expired_at")
  rejectedAt                    DateTime?                 @map("rejected_at")
  consumedAt                    DateTime?                 @map("consumed_at")
  claimantUserId                String?                   @map("claimant_user_id")
  claimantOrganizationId        String?                   @map("claimant_organization_id")
  controllerInstallationId      String?                   @map("controller_installation_id") @db.Uuid
  controllerLabel               String?                   @map("controller_label")
  webauthnChallenge             String?                   @map("webauthn_challenge")
  challengeIssuedAt             DateTime?                 @map("challenge_issued_at")
  challengeExpiresAt            DateTime?                 @map("challenge_expires_at")
  challengeConsumedAt           DateTime?                 @map("challenge_consumed_at")
  credentialId                  String?                   @unique @map("credential_id")
  credentialPublicKeyX          Bytes?                    @map("credential_public_key_x")
  credentialPublicKeyY          Bytes?                    @map("credential_public_key_y")
  credentialTransports          String[]                  @default([]) @map("credential_transports")
  credentialAaguid              Bytes?                    @map("credential_aaguid")
  credentialSignCount           Int?                      @map("credential_sign_count")
  credentialBackupEligible      Boolean?                  @map("credential_backup_eligible")
  credentialBackupState         Boolean?                  @map("credential_backup_state")
  credentialFingerprint         String?                   @map("credential_fingerprint") @db.VarChar(64)
  credentialVerifiedAt          DateTime?                 @map("credential_verified_at")
  browserBindingCredentialHash  String?                   @unique @map("browser_binding_credential_hash") @db.VarChar(64)
  browserBindingIssuedAt        DateTime?                 @map("browser_binding_issued_at")
  browserBindingExpiresAt       DateTime?                 @map("browser_binding_expires_at")
  localOutcomeCode              String?                   @map("local_outcome_code") @db.VarChar(64)
  localOutcomeIssuedAt          DateTime?                 @map("local_outcome_issued_at")
  localOutcomeConsumedAt        DateTime?                 @map("local_outcome_consumed_at")
  lastPolledAt                  DateTime?                 @map("last_polled_at")
  confirmationNonce             String?                   @map("confirmation_nonce")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  claimantUser               User?                           @relation("PendingMachineEnrollmentClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)
  claimantOrganization       Organization?                   @relation(fields: [claimantOrganizationId], references: [id], onDelete: Cascade)
  claimFailures              MachineEnrollmentClaimFailure[]
  activeControllerCredential MachineControllerCredential?

  @@index([expiresAt], map: "pending_machine_enrollments_expires_at_idx")
  @@index([machineId], map: "pending_machine_enrollments_machine_id_idx")
  @@index([state, expiresAt], map: "pending_machine_enrollments_state_expires_at_idx")
  @@index([machinePublicKeyFingerprint, state, expiresAt], map: "pending_machine_enrollments_fingerprint_state_expires_at_idx")
  @@index([challengeExpiresAt], map: "pending_machine_enrollments_challenge_expires_at_idx")
  @@index([state, challengeExpiresAt], map: "pending_machine_enrollments_state_challenge_expiry_idx")
  @@index([id, state], map: "pending_machine_enrollments_id_state_idx")
  @@index([claimantUserId, state], map: "pending_machine_enrollments_claimant_state_idx")
  @@index([controllerInstallationId], map: "pending_machine_enrollments_controller_installation_idx")
  @@map("pending_machine_enrollments")
}

