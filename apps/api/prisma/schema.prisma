/// In-product help library: a tree of articles with markdown bodies. Global
/// to the product — no organization/project scoping. Sibling-uniqueness on
/// (parent_id, slug) lets URLs resolve by walking the parent chain; a partial
/// unique index covers the root grouping where parent_id IS NULL. Kept in
/// sync with db/flyway/V2026.06.19.1__create_help_node_and_help_demo.sql;
/// Flyway is the sole migration system — never `prisma migrate`.
///
/// Search note: `help_node_title_body_trgm_idx` is an EXPRESSION index on
/// `(title || ' ' || body)`. The planner only uses it when the read-side
/// WHERE clause contains that same expression verbatim — `title ILIKE ... OR
/// body ILIKE ...` will sequential-scan.
model HelpNode {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String
  title     String
  body      String   @default("")
  ordering  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   HelpNode?  @relation("HelpNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children HelpNode[] @relation("HelpNodeChildren")
  demos    HelpDemo[]

  @@unique([parentId, slug])
  @@map("help_node")
}

/// Inline demos hung off a HelpNode. `kind` discriminates the payload:
/// 'preset' references a hard-coded scene by `presetKey`; 'dsl' carries an
/// authored definition inline. The SQL CHECK enforces XOR; Prisma cannot
/// model that, so callers must respect it. Kept in sync with
/// db/flyway/V2026.06.19.1__create_help_node_and_help_demo.sql.
model HelpDemo {
  id         String   @id @default(uuid()) @db.Uuid
  helpNodeId String   @map("help_node_id") @db.Uuid
  ordering   Int
  caption    String   @default("")
  kind       String
  presetKey  String?  @map("preset_key")
  definition Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  helpNode HelpNode @relation(fields: [helpNodeId], references: [id], onDelete: Cascade)

  @@index([helpNodeId])
  @@map("help_demo")
}

