/// One row per OPEN SYSTEM trigger eligible for reconnect recovery, keyed by
/// the human user who owns the conversation (resolved through the bound
/// AgentSession, since SYSTEM trigger messages carry user_id = 'system').
/// Maintained from the message log by MessageService.addMessage: inserted when
/// a SYSTEM message carrying data.triggersAgent is written, deleted when a
/// completion references it via completesExternalAgentNode, and also removed
/// when an initial start-run dispatch receives a negative acknowledgement. The
/// message remains in the log in that last case; only reconnect eligibility is
/// discarded. This is the materialized "triggers − completions − failed
/// initial dispatches" set the per-user re-fan reads.
/// Kept in sync with db/flyway/V2026.05.28.1__create_pending_open_trigger.sql;
/// Flyway is the sole migration system — never `prisma migrate`.
model PendingOpenTrigger {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  messageId      String   @unique @map("message_id")
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_open_trigger")
}

