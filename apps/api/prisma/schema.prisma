  scheduledFor   DateTime?         @map("scheduled_for")
  lastError      String?           @map("last_error")
  errorCount     Int               @default(0) @map("error_count")
  partitionKey   String            @map("partition_key")
  sequenceNumber BigInt            @default(0) @map("sequence_number")
  sourceService  String            @map("source_service")
  sourceMethod   String            @map("source_method")
  sourceVersion  String?           @map("source_version")
  userId         String?           @map("user_id")
  organizationId String?           @map("organization_id")
  projectId      String?           @map("project_id")
  conversationId String?           @map("conversation_id")
  workflowId     String?           @map("workflow_id")

  @@unique([aggregateType, aggregateId, eventType, sequenceNumber], map: "ux_outbox_agg_seq")
  @@index([status, nextRetryAt, partitionKey])
  @@index([correlationId])
  @@index([causationId])
  @@index([sagaId])
  @@index([aggregateType, aggregateId])
  @@index([partitionKey, sequenceNumber])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([workflowId, createdAt])
  @@index([eventType, createdAt])
  // Edit history optimized index for efficient queries by initiative and event type with timestamp ordering
  @@index([aggregateId, eventType, createdAt])
  @@map("outbox_events")
}

