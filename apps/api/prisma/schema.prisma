generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("PROJECT_DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  projectReportRequests                 ProjectReportRequest[]
  defaultOrganizationId                 String?                           @map("default_organization_id")
  id                                    String                            @id @default(uuid())
  email                                 String                            @unique
  name                                  String
  passwordHash                          String                            @map("password_hash")
  isActive                              Boolean                           @default(true) @map("is_active")
  lastLoginAt                           DateTime?                         @map("last_login_at")
  createdAt                             DateTime                          @default(now()) @map("created_at")
  updatedAt                             DateTime                          @updatedAt @map("updated_at")
  devAdminMode                          Boolean                           @default(false) @map("dev_admin_mode")
  isDevAdmin                            Boolean                           @default(false) @map("is_dev_admin")
  mustChangePassword                    Boolean                           @default(false) @map("must_change_password")
  isDemoUser                            Boolean                           @default(false) @map("is_demo_user")
  demoSandboxes                         DemoSandbox[]
  flowExecutions                        FlowExecution[]
  llmPromptResponses                    LLMPromptResponse[]
  memberships                           OrganizationMember[]
  createdProjects                       Project[]                         @relation("ProjectCreator")
  assignedTasks                         Task[]                            @relation("AssignedTasks")
  createdTasks                          Task[]                            @relation("CreatedTasks")
  taskDependenciesCreated               TaskDependency[]                  @relation("TaskDependencyCreator")
  assignedInitiatives                   Initiative[]                      @relation("InitiativeAssignee")
  lastModifiedInitiatives               Initiative[]                      @relation("InitiativeLastModifier")
  userOrganizations                     UserOrganization[]
  apiKeys                               ApiKey[]                          @relation("ApiKeyCreator")
  agentSessions                         AgentSession[]
  validationSessions                    ValidationSession[]
  entityStars                           EntityStar[]
  openItemCollections                   OpenItemCollection[]
  proposalApprovals                     ProposalApprovalRecord[]
  notifications                         Notification[]
  notificationDeliveryAttempts          NotificationDeliveryAttempt[]
  notificationPreferences               NotificationPreference[]
  taskSectionHistoryEntries             TaskSectionHistory[]              @relation("TaskSectionHistoryAuthor")
  projectMemberships                    ProjectMember[]
  goalMemberships                       GoalMembership[]
  machines                              Machine[]
  pairingCodes                          PairingCode[]
  pairingAttempts                       PairingAttempt[]
  pendingOpenTriggers                   PendingOpenTrigger[]
  monitorCommands                       MonitorCommand[]
  browserSessionFamilies                BrowserSessionFamily[]
  passwordChangeCredentials             PasswordChangeCredential[]
  bugReportIntakeContexts               BugReportIntakeContext[]
  organizationProjectEntitlementUpdates OrganizationProjectEntitlement[]  @relation("OrganizationProjectEntitlementUpdater")
  pendingControllerClaims               PendingMachineEnrollment[]        @relation("PendingMachineEnrollmentClaimant")
  machineEnrollmentClaimFailures        MachineEnrollmentClaimFailure[]
  machineControllerCredentials          MachineControllerCredential[]
  executionAuthorizations               ExecutionAuthorization[]
  executionGrants                       ExecutionGrant[]
  controllerBrowserBindings             ControllerBrowserBinding[]
  agentOperations                       AgentOperation[]
  privateBetaDisclosureAcceptances      PrivateBetaDisclosureAcceptance[]

  @@map("users")
}

model BrowserSessionFamily {
  id                    String              @id @default(uuid())
  userId                String              @map("user_id")
  currentOrganizationId String?             @map("current_organization_id")
  sessionId             String              @unique @map("session_id")
  familyId              String              @unique @map("family_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  lastUsedAt            DateTime            @default(now()) @map("last_used_at")
  inactivityExpiresAt   DateTime            @map("inactivity_expires_at")
  absoluteExpiresAt     DateTime            @map("absolute_expires_at")
  revokedAt             DateTime?           @map("revoked_at")
  revocationReason      String?             @map("revocation_reason") @db.VarChar(64)
  createdIpAddress      String?             @map("created_ip_address") @db.VarChar(45)
  createdUserAgent      String?             @map("created_user_agent") @db.VarChar(512)
  lastUsedIpAddress     String?             @map("last_used_ip_address") @db.VarChar(45)
  lastUsedUserAgent     String?             @map("last_used_user_agent") @db.VarChar(512)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshGenerations    RefreshGeneration[]

  @@index([userId, revokedAt])
  @@index([inactivityExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("browser_session_families")
}

model RefreshGeneration {
  id                     String               @id @default(uuid())
  browserSessionFamilyId String               @map("browser_session_family_id")
  generation             Int
  secretHash             String               @unique @map("secret_hash") @db.VarChar(128)
  issuedAt               DateTime             @default(now()) @map("issued_at")
  consumedAt             DateTime?            @map("consumed_at")
  browserSessionFamily   BrowserSessionFamily @relation(fields: [browserSessionFamilyId], references: [id], onDelete: Cascade)

  @@unique([browserSessionFamilyId, generation])
  @@index([browserSessionFamilyId, consumedAt])
  @@index([issuedAt])
  @@index([consumedAt])
  @@map("refresh_generations")
}

model PasswordChangeCredential {
  id                         String                       @id @default(uuid())
  credentialId               String                       @unique @map("credential_id") @db.VarChar(128)
  userId                     String                       @map("user_id")
  privateBetaAccessRequestId String?                      @unique @map("private_beta_access_request_id")
  issuanceKind               PasswordChangeCredentialKind @default(REQUIRED_CHANGE) @map("issuance_kind")
  issuedAt                   DateTime                     @default(now()) @map("issued_at")
  expiresAt                  DateTime?                    @map("expires_at")
  consumedAt                 DateTime?                    @map("consumed_at")
  revokedAt                  DateTime?                    @map("revoked_at")
  issuedIpAddress            String?                      @map("issued_ip_address") @db.VarChar(45)
  issuedUserAgent            String?                      @map("issued_user_agent") @db.VarChar(512)
  consumedIpAddress          String?                      @map("consumed_ip_address") @db.VarChar(45)
  consumedUserAgent          String?                      @map("consumed_user_agent") @db.VarChar(512)
  user                       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  privateBetaAccessRequest   PrivateBetaAccessRequest?    @relation(fields: [privateBetaAccessRequestId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("password_change_credentials")
}

enum PasswordChangeCredentialKind {
  REQUIRED_CHANGE
  ACCOUNT_RECOVERY

  @@map("password_change_credential_kind")
}

enum ApiKeyType {
  INTERNAL // For internal API authentication
  MASTRA_AI // For Mastra.ai service authentication

  @@map("api_key_type")
}

model ApiKey {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  description    String?
  keyHash        String     @unique @map("key_hash") // Store hashed version of the key
  prefix         String // First 8 chars for identification (e.g., "hh_prod_")
  keyType        ApiKeyType @default(INTERNAL) @map("key_type") // Type of API key
  serviceType    String?    @map("service_type") // External service identifier (e.g., "mastra-ai")
  scopes         String[] // Array of permission scopes
  lastUsedAt     DateTime?  @map("last_used_at")
  lastUsedIp     String?    @map("last_used_ip")
  expiresAt      DateTime?  @map("expires_at")
  isActive       Boolean    @default(true) @map("is_active")
  createdBy      String     @map("created_by") // userId who created it
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ApiKeyCreator", fields: [createdBy], references: [id])

  @@unique([organizationId, keyType, serviceType]) // Ensure one key per org per service type
  @@index([organizationId, isActive])
  @@index([keyHash])
  @@index([prefix])
  @@index([organizationId, keyType, serviceType])
  @@map("api_keys")
}

model PrivateBetaAccessRequest {
  id                                        String                                 @id @default(uuid())
  submittedEmail                            String                                 @map("submitted_email") @db.VarChar(254)
  normalizedEmail                           String                                 @map("normalized_email") @db.VarChar(254)
  name                                      String                                 @db.VarChar(120)
  organizationName                          String                                 @map("organization_name") @db.VarChar(200)
  teamSize                                  Int?                                   @map("team_size")
  productContext                            String?                                @map("product_context") @db.VarChar(2000)
  accessRationale                           String?                                @map("access_rationale") @db.VarChar(2000)
  status                                    PrivateBetaAccessRequestStatus         @default(PENDING)
  createdAt                                 DateTime                               @default(now()) @map("created_at")
  decisionAt                                DateTime?                              @map("decision_at")
  provisionedUserId                         String?                                @unique @map("provisioned_user_id")
  provisionedOrganizationId                 String?                                @unique @map("provisioned_organization_id")
  provisioningAttemptedAt                   DateTime?                              @map("provisioning_attempted_at")
  provisioningCompletedAt                   DateTime?                              @map("provisioning_completed_at")
  provisioningFailureCode                   String?                                @map("provisioning_failure_code") @db.VarChar(120)
  provisioningError                         String?                                @map("provisioning_error") @db.VarChar(2000)
  provisioningUserCompletedAt               DateTime?                              @map("provisioning_user_completed_at")
  provisioningOrganizationCompletedAt       DateTime?                              @map("provisioning_organization_completed_at")
  provisioningCredentialId                  String?                                @unique @map("provisioning_credential_id")
  provisioningCredentialCompletedAt         DateTime?                              @map("provisioning_credential_completed_at")
  provisioningOrganizationApiKeyId          String?                                @unique @map("provisioning_organization_api_key_id")
  provisioningOrganizationApiKeyCompletedAt DateTime?                              @map("provisioning_organization_api_key_completed_at")
  welcomeEmailIdempotencyKey                String?                                @unique @map("welcome_email_idempotency_key") @db.VarChar(255)
  welcomeEmailSentAt                        DateTime?                              @map("welcome_email_sent_at")
  passwordChangeCredential                  PasswordChangeCredential?
  notificationAttempts                      PrivateBetaAccessNotificationAttempt[]

  // Flyway owns the partial unique index for one pending request per normalized email.
  @@index([normalizedEmail])
  @@index([status, createdAt])
  @@map("private_beta_access_requests")
}

model PrivateBetaAccessProgramState {
  id                                  String                              @id @db.VarChar(32)
  closedAt                            DateTime?                           @map("closed_at")
  closedByUserId                      String?                             @map("closed_by_user_id") @db.Uuid
  selfServiceAdmissionMode            PrivateBetaSelfServiceAdmissionMode @default(OPEN) @map("self_service_admission_mode")
  selfServiceAdmissionUpdatedAt       DateTime                            @default(now()) @map("self_service_admission_updated_at")
  selfServiceAdmissionUpdatedByUserId String?                             @map("self_service_admission_updated_by_user_id") @db.Uuid
  createdAt                           DateTime                            @default(now()) @map("created_at")
  updatedAt                           DateTime                            @updatedAt @map("updated_at")

  @@map("private_beta_access_program_state")
}

enum PrivateBetaSelfServiceAdmissionMode {
  OPEN
  PAUSED

  @@map("private_beta_self_service_admission_mode")
}

model PrivateBetaDisclosureAcceptance {
  id             String                            @id @default(uuid())
  userId         String                            @map("user_id")
  organizationId String                            @map("organization_id")
  documentKind   PrivateBetaDisclosureDocumentKind @map("document_kind")
  version        String                            @db.VarChar(128)
  effectiveDate  DateTime                          @map("effective_date") @db.Date
  actionType     PrivateBetaDisclosureActionType   @map("action_type")
  acceptedAt     DateTime                          @default(now()) @map("accepted_at")
  user           User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, documentKind, version], map: "private_beta_disclosure_acceptances_identity_key")
  @@index([userId, organizationId, documentKind])
  @@map("private_beta_disclosure_acceptances")
}

enum PrivateBetaDisclosureDocumentKind {
  TERMS
  PRIVACY
  SECURITY

  @@map("private_beta_disclosure_document_kind")
}

enum PrivateBetaDisclosureActionType {
  AGREED
  ACKNOWLEDGED

  @@map("private_beta_disclosure_action_type")
}

model PrivateBetaAccessNotificationAttempt {
  id             String                                     @id @default(uuid())
  requestId      String                                     @map("request_id")
  recipientRole  PrivateBetaAccessNotificationRecipientRole @map("recipient_role")
  deliveryState  PrivateBetaAccessNotificationDeliveryState @default(PENDING) @map("delivery_state")
  attemptCount   Int                                        @default(0) @map("attempt_count")
  maxAttempts    Int                                        @default(8) @map("max_attempts")
  claimedAt      DateTime?                                  @map("claimed_at")
  claimExpiresAt DateTime?                                  @map("claim_expires_at")
  claimToken     String?                                    @map("claim_token")
  lastAttemptAt  DateTime?                                  @map("last_attempt_at")
  deliveredAt    DateTime?                                  @map("delivered_at")
  lastError      String?                                    @map("last_error") @db.VarChar(2000)
  nextRetryAt    DateTime?                                  @map("next_retry_at")
  createdAt      DateTime                                   @default(now()) @map("created_at")
  updatedAt      DateTime                                   @updatedAt @map("updated_at")

  request PrivateBetaAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, recipientRole], map: "private_beta_access_notification_attempts_request_role_key")
  @@index([deliveryState, nextRetryAt], map: "private_beta_access_notification_attempts_due_idx")
  @@index([deliveryState, claimExpiresAt], map: "private_beta_access_notification_attempts_claim_idx")
  @@map("private_beta_access_notification_attempts")
}

model Organization {
  demoGraphCopyIntents DemoGraphCopyIntent[]
  projectReportRequests             ProjectReportRequest[]
  proposalFutures                   ProposalFuture[]
  id                                String                             @id @default(uuid())
  name                              String
  slug                              String                             @unique
  description                       String?
  settings                          Json                               @default("{}")
  isActive                          Boolean                            @default(true) @map("is_active")
  createdAt                         DateTime                           @default(now()) @map("created_at")
  updatedAt                         DateTime                           @updatedAt @map("updated_at")
  artifacts                         Artifact[]
  influences                        Influence[]
  conversations                     Conversation[]
  ConversationHistoryConfig         ConversationHistoryConfig[]
  featureFlags                      FeatureFlag[]
  flowExecutions                    FlowExecution[]
  initiatives                       Initiative[]
  designDocs                        DesignDoc[]
  integrations                      Integration[]
  llmPromptResponses                LLMPromptResponse[]
  unifiedSearchLogs                 UnifiedSearchLog[]
  organizationFlowPermissions       OrganizationFlowPermission[]
  members                           OrganizationMember[]
  projects                          Project[]
  services                          Service[]
  tags                              Tag[]
  tasks                             Task[]
  entityRegistry                    EntityRegistry[]
  UserOrganization                  UserOrganization[]
  userSuggestions                   UserSuggestion[]
  suggestionDecisions               SuggestionDecision[]
  apiKeys                           ApiKey[]
  agentSessions                     AgentSession[]
  agentOperations                   AgentOperation[]
  validationSessions                ValidationSession[]
  reports                           Report[]
  subfacetConsolidationRuns         SubfacetConsolidationRun[]
  categorySummarizationRuns         CategorySummarizationRun[]
  subfacetSummarizationRuns         SubfacetSummarizationRun[]
  topologyConsolidationSchedules    TopologyConsolidationSchedule[]
  topologyConsolidationRuns         TopologyConsolidationRun[]
  topologyConsolidationEntityStates TopologyConsolidationEntityState[]
  topologySubfacetCandidates        TopologySubfacetCandidate[]
  topologyCategorySummaries         TopologyCategorySummary[]
  subfacets                         Subfacet[]
  entitySummaries                   EntitySummary[]
  entityStars                       EntityStar[]
  openItemCollections               OpenItemCollection[]
  notifications                     Notification[]
  notificationDeliveryAttempts      NotificationDeliveryAttempt[]
  notificationPreferences           NotificationPreference[]
  proposals                         Proposal[]
  proposalGroups                    ProposalGroup[]
  pendingProposalEdges              PendingProposalEdge[]
  monitorCommands                   MonitorCommand[]
  workItemChangeSetMaterializations WorkItemChangeSetMaterialization[]
  pendingOpenTriggers               PendingOpenTrigger[]
  projectEntitlement                OrganizationProjectEntitlement?
  accountEntitlement                AccountEntitlement?
  paymentProviderBindings           PaymentProviderBinding[]
  paymentProviderEvents             PaymentProviderEventInbox[]
  githubWebhookInbox                GitHubWebhookInbox[]
  accountLifecycle                  OrganizationAccountLifecycle?
  capacityUsage                     OrganizationCapacityUsage?
  pendingControllerClaims           PendingMachineEnrollment[]
  machines                          Machine[]
  machineControllerCredentials      MachineControllerCredential[]
  executionAuthorizations           ExecutionAuthorization[]
  executionGrants                   ExecutionGrant[]
  controllerBrowserBindings         ControllerBrowserBinding[]
  privateBetaDisclosureAcceptances  PrivateBetaDisclosureAcceptance[]
  agentInteractions                 AgentInteraction[]

  @@map("organizations")
}

model OrganizationProjectEntitlement {
  organizationId       String       @id @map("organization_id")
  projectLimitOverride Int?         @map("project_limit_override")
  updatedBy            String?      @map("updated_by")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updater              User?        @relation("OrganizationProjectEntitlementUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("organization_project_entitlements")
}

enum AccountSubscriptionType {
  BETA
  PAID

  @@map("account_subscription_type")
}

enum AccountAccessStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("account_access_status")
}

model AccountEntitlement {
  organizationId   String                         @id @map("organization_id")
  subscriptionType AccountSubscriptionType        @map("subscription_type")
  accessStatus     AccountAccessStatus            @map("access_status")
  accessThroughAt  DateTime?                      @map("access_through_at")
  paidThroughAt    DateTime?                      @map("paid_through_at")
  revision         Int                            @default(1)
  createdAt        DateTime                       @default(now()) @map("created_at")
  createdBy        String                         @map("created_by") @db.VarChar(120)
  createdReason    String                         @map("created_reason") @db.VarChar(255)
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  updatedBy        String                         @map("updated_by") @db.VarChar(120)
  updateReason     String                         @map("update_reason") @db.VarChar(255)
  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transitions      AccountEntitlementTransition[]

  @@map("account_entitlements")
}

model AccountEntitlementTransition {
  id                       String                   @id @default(uuid())
  organizationId           String                   @map("organization_id")
  fromRevision             Int?                     @map("from_revision")
  toRevision               Int                      @map("to_revision")
  previousSubscriptionType AccountSubscriptionType? @map("previous_subscription_type")
  subscriptionType         AccountSubscriptionType  @map("subscription_type")
  previousAccessStatus     AccountAccessStatus?     @map("previous_access_status")
  accessStatus             AccountAccessStatus      @map("access_status")
  previousAccessThroughAt  DateTime?                @map("previous_access_through_at")
  accessThroughAt          DateTime?                @map("access_through_at")
  previousPaidThroughAt    DateTime?                @map("previous_paid_through_at")
  paidThroughAt            DateTime?                @map("paid_through_at")
  changedAt                DateTime                 @default(now()) @map("changed_at")
  changedBy                String                   @map("changed_by") @db.VarChar(120)
  reason                   String                   @db.VarChar(255)
  entitlement              AccountEntitlement       @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@unique([organizationId, toRevision])
  @@index([organizationId, changedAt])
  @@map("account_entitlement_transitions")
}

enum PaymentProviderBindingStatus {
  ACTIVE
  DISABLED

  @@map("payment_provider_binding_status")
}

model PaymentProviderBinding {
  id                                String                       @id @default(uuid())
  organizationId                    String                       @map("organization_id")
  provider                          String                       @db.VarChar(64)
  environment                       String                       @db.VarChar(32)
  externalCustomerId                String?                      @map("external_customer_id") @db.VarChar(255)
  externalSubscriptionId            String?                      @map("external_subscription_id") @db.VarChar(255)
  lastAcceptedProviderEventSequence BigInt?                      @map("last_accepted_provider_event_sequence")
  lastAcceptedProviderEventVersion  String?                      @map("last_accepted_provider_event_version") @db.VarChar(255)
  lastAcceptedProviderOccurredAt    DateTime?                    @map("last_accepted_provider_occurred_at")
  status                            PaymentProviderBindingStatus @default(ACTIVE)
  revision                          Int                          @default(1)
  createdAt                         DateTime                     @default(now()) @map("created_at")
  createdBy                         String                       @map("created_by") @db.VarChar(120)
  createdReason                     String                       @map("created_reason") @db.VarChar(255)
  updatedAt                         DateTime                     @updatedAt @map("updated_at")
  updatedBy                         String                       @map("updated_by") @db.VarChar(120)
  updateReason                      String                       @map("update_reason") @db.VarChar(255)
  organization                      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events                            PaymentProviderEventInbox[]

  @@index([organizationId, status])
  @@map("payment_provider_bindings")
}

enum PaymentProviderEventProcessingStatus {
  RECEIVED
  ACCEPTED
  IGNORED
  FAILED

  @@map("payment_provider_event_processing_status")
}

model PaymentProviderEventInbox {
  id                          String                               @id @default(uuid())
  organizationId              String?                              @map("organization_id")
  bindingId                   String?                              @map("binding_id")
  provider                    String                               @db.VarChar(64)
  environment                 String                               @db.VarChar(32)
  providerEventId             String                               @map("provider_event_id") @db.VarChar(255)
  normalizedEventKind         String                               @map("normalized_event_kind") @db.VarChar(100)
  payloadHash                 String                               @map("payload_hash") @db.VarChar(128)
  providerOccurredAt          DateTime?                            @map("provider_occurred_at")
  providerEventVersion        String?                              @map("provider_event_version") @db.VarChar(255)
  providerEventSequence       BigInt?                              @map("provider_event_sequence")
  processingStatus            PaymentProviderEventProcessingStatus @default(RECEIVED) @map("processing_status")
  failureReason               String?                              @map("failure_reason") @db.VarChar(2000)
  acceptedEntitlementRevision Int?                                 @map("accepted_entitlement_revision")
  processedAt                 DateTime?                            @map("processed_at")
  createdAt                   DateTime                             @default(now()) @map("created_at")
  updatedAt                   DateTime                             @updatedAt @map("updated_at")
  organization                Organization?                        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  binding                     PaymentProviderBinding?              @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, providerEventId])
  @@index([bindingId, createdAt])
  @@index([organizationId, createdAt])
  @@index([processingStatus, createdAt])
  @@map("payment_provider_event_inbox")
}

enum OrganizationAccountLifecycleState {
  ACTIVE
  SUSPENDED
  IRREVERSIBLY_CLOSED
  DELETED

  @@map("organization_account_lifecycle_state")
}

model OrganizationAccountLifecycle {
  organizationId             String                                   @id @map("organization_id")
  lifecycleState             OrganizationAccountLifecycleState        @map("lifecycle_state")
  accessEndsAt               DateTime?                                @map("access_ends_at")
  deletionEligibleAt         DateTime?                                @map("deletion_eligible_at")
  irreversibleClosureAt      DateTime?                                @map("irreversible_closure_at")
  deletedAt                  DateTime?                                @map("deleted_at")
  closureEntitlementRevision Int?                                     @map("closure_entitlement_revision")
  revision                   Int                                      @default(1)
  createdAt                  DateTime                                 @default(now()) @map("created_at")
  createdBy                  String                                   @map("created_by") @db.VarChar(120)
  createdReason              String                                   @map("created_reason") @db.VarChar(255)
  updatedAt                  DateTime                                 @updatedAt @map("updated_at")
  updatedBy                  String                                   @map("updated_by") @db.VarChar(120)
  updateReason               String                                   @map("update_reason") @db.VarChar(255)
  organization               Organization                             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transitions                OrganizationAccountLifecycleTransition[]

  @@map("organization_account_lifecycles")
}

model OrganizationAccountLifecycleTransition {
  id                                 String                             @id @default(uuid())
  organizationId                     String                             @map("organization_id")
  fromRevision                       Int?                               @map("from_revision")
  toRevision                         Int                                @map("to_revision")
  previousLifecycleState             OrganizationAccountLifecycleState? @map("previous_lifecycle_state")
  lifecycleState                     OrganizationAccountLifecycleState  @map("lifecycle_state")
  previousAccessEndsAt               DateTime?                          @map("previous_access_ends_at")
  accessEndsAt                       DateTime?                          @map("access_ends_at")
  previousDeletionEligibleAt         DateTime?                          @map("previous_deletion_eligible_at")
  deletionEligibleAt                 DateTime?                          @map("deletion_eligible_at")
  previousIrreversibleClosureAt      DateTime?                          @map("previous_irreversible_closure_at")
  irreversibleClosureAt              DateTime?                          @map("irreversible_closure_at")
  previousDeletedAt                  DateTime?                          @map("previous_deleted_at")
  deletedAt                          DateTime?                          @map("deleted_at")
  previousClosureEntitlementRevision Int?                               @map("previous_closure_entitlement_revision")
  closureEntitlementRevision         Int?                               @map("closure_entitlement_revision")
  changedAt                          DateTime                           @default(now()) @map("changed_at")
  changedBy                          String                             @map("changed_by") @db.VarChar(120)
  reason                             String                             @db.VarChar(255)
  lifecycle                          OrganizationAccountLifecycle       @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@unique([organizationId, toRevision])
