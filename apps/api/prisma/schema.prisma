  message        Message?                             @relation("AgentOperationMessage", fields: [messageId], references: [id])
  triggerMessage Message?                             @relation("AgentOperationTriggerMessage", fields: [triggerMessageId], references: [id])
  grant          ExecutionGrant?                      @relation("AgentOperationGrant", fields: [grantId], references: [id], onDelete: Restrict)
  dispatch       AgentOperationDispatch?
  workflowInput  AgentOperationWorkflowInputDelivery?

  @@index([agentSessionId, createdAt], map: "agent_operations_session_created_idx")
  @@map("agent_operations")
}

enum AgentOperationWorkflowInputState {
  PENDING
  CLAIMED
  DELIVERED

  @@map("agent_operation_workflow_input_state")
}

enum AgentOperationWorkflowInputKind {
  WORKFLOW_ANSWER
  START_RUN_KICKOFF

  @@map("agent_operation_workflow_input_kind")
}

model AgentOperationWorkflowInputDelivery {
  operationId     String                           @id @map("operation_id") @db.Uuid
  kind            AgentOperationWorkflowInputKind
  workflowId      String                           @map("workflow_id")
  workflowName    String                           @map("workflow_name")
  nodeId          String?                          @map("node_id")
