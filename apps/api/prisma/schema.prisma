  admittingMachineId   String    @map("admitting_machine_id")
  projectionId         String    @unique @map("projection_id")
  expiresAt            DateTime? @map("expires_at")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSession AgentSession              @relation("InteractionSourceSession", fields: [sourceSessionId], references: [id], onDelete: Restrict)
  attempts      AgentInteractionAttempt[]
  effects       AgentInteractionEffect[]

  @@unique([sourceSessionId, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("agent_interactions")
}

model AgentInteractionAttempt {
  id                    String    @id @default(uuid())
  interactionId         String    @map("interaction_id")
  ordinal               Int
  targetSessionId       String    @map("target_session_id")
  targetTurnId          String?   @unique @map("target_turn_id")
  generation            Int       @default(1)
  state                 String    @default("PENDING")
  authority             Json
  objective             String?
  answerReference       String?   @map("answer_reference")
  result                Json?
  settledAt             DateTime? @map("settled_at")
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  /// Retained controller evidence for browser-requested child work; all four are null for legacy attempts.
  authorizationKind     String?   @map("authorization_kind")
  authorizationId       String?   @map("authorization_id")
  envelopeAuthorization Json?     @map("envelope_authorization")
  actionPayloadHash     String?   @map("action_payload_hash")

  interaction    AgentInteraction            @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  targetSession  AgentSession                @relation("AttemptTargetSession", fields: [targetSessionId], references: [id], onDelete: Restrict)
  effects        AgentInteractionEffect[]
  turnAdmissions AgentSessionTurnAdmission[]

  @@unique([interactionId, ordinal])
  @@index([targetSessionId, state])
  @@map("agent_interaction_attempts")
}

model AgentInteractionEffect {
  id             String    @id @default(uuid())
  interactionId  String    @map("interaction_id")
  attemptId      String    @map("attempt_id")
  generation     Int
  kind           String
  state          String    @default("BLOCKED")
  claimOwner     String?   @map("claim_owner")
  claimExpiresAt DateTime? @map("claim_expires_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  outcome        Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  interaction AgentInteraction        @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  attempt     AgentInteractionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, generation, kind])
  @@index([state, claimExpiresAt, createdAt])
  @@map("agent_interaction_effects")
}

model AgentSessionTurnSlot {
  agentSessionId      String   @id @map("agent_session_id")
  revision            Int      @default(0)
  nextOrdinal         Int      @default(1) @map("next_ordinal")
  occupiedAdmissionId String?  @unique @map("occupied_admission_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  agentSession AgentSession @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)

  @@map("agent_session_turn_slots")
}

model AgentSessionTurnAdmission {
  id                   String   @id @default(uuid())
  agentSessionId       String   @map("agent_session_id")
  source               String
  state                String   @default("QUEUED")
  ordinal              Int
  generation           Int      @default(1)
  idempotencyKey       String   @map("idempotency_key")
  authorKind           String   @map("author_kind")
  authorUserId         String?  @map("author_user_id")
