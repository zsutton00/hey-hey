# Database
# Primary runtime variable used by Prisma
PROJECT_DATABASE_URL="postgresql://username:password@localhost:5432/hey-hey-db?schema=public"
# Optional split database fields (used by container entrypoint to compose PROJECT_DATABASE_URL)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="hey-hey-db" # database name only (not a URL)
POSTGRES_USER="username"
POSTGRES_PASSWORD=""
POSTGRES_SCHEMA="public"
# Legacy compatibility variable for scripts/tools that still read DATABASE_URL
DATABASE_URL="postgresql://username:password@localhost:5432/hey-hey-db?schema=public"

# pgAdmin (local Docker UI at http://localhost:5050)
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="admin"

# JWT
JWT_SECRET="your-jwt-secret"
JWT_EXPIRATION="3600s"
# Optional RSA signing and verification keys. When omitted, local development
# loads or generates an ignored pair under config/keys.
# Provide a matching pair directly or through JWT_PRIVATE_KEY_FILE/JWT_PUBLIC_KEY_FILE mounted secrets.
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
# JWT_KEY_ID="default-key"

# Protocol-version-2 machine enrollment
# Dedicated high-entropy server-side key for HMAC-SHA-256 of human enrollment codes.
# Never reuse JWT, session, or other application signing keys for this purpose.
MACHINE_ENROLLMENT_CODE_HMAC_KEY="replace-with-a-random-32-byte-or-longer-secret"
MACHINE_ENROLLMENT_WEBAUTHN_RP_ID="localhost.test"
MACHINE_ENROLLMENT_WEBAUTHN_ORIGIN="https://localhost.test"

# Browser authentication policy
# Browser access JWT lifetime (15 minutes)
BROWSER_ACCESS_TOKEN_TTL_SECONDS="900"
# Sliding inactivity bound for browser refresh sessions (7 days)
BROWSER_SESSION_INACTIVITY_TTL_SECONDS="604800"
# Fixed browser-session lifetime that refresh cannot extend (30 days)
BROWSER_SESSION_ABSOLUTE_TTL_SECONDS="2592000"
# Maximum password-change credential lifetime (15 minutes)
PASSWORD_CHANGE_TOKEN_TTL_SECONDS="900"
# Independent account-recovery credential lifetime (15 minutes maximum)
PASSWORD_RECOVERY_TOKEN_TTL_SECONDS="900"
# Recovery initiation limits per normalized account and trusted source window
PASSWORD_RECOVERY_ACCOUNT_LIMIT="3"
PASSWORD_RECOVERY_SOURCE_LIMIT="10"
PASSWORD_RECOVERY_THROTTLE_WINDOW_SECONDS="900"
# Secret used to derive request-idempotent welcome credentials; keep stable across deployments
PASSWORD_CHANGE_IDEMPOTENCY_SECRET="replace-with-a-stable-secret"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# Temporal
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"

# Logging
LOG_LEVEL="info"

LOG_FORMAT="pretty" # set to json for structured stdout
LOG_TO_FILE="true"
LOGSTASH_ENABLED="false"
LOGSTASH_HOST="localhost"
LOGSTASH_PORT="5000"

# API traces are opt-in. Production remains disabled until a separate sampling
# and retention policy is approved. The exporter requires an internal Alloy
# endpoint, for example OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318.
API_TRACING_ENABLED="false"
API_TRACING_SAMPLE_RATE="0.05"
API_TRACING_DIAGNOSTIC_MODE="false"
API_TRACING_MAX_QUEUE_SIZE="2048"
# Full sampling is accepted only with DEPLOYMENT_ENVIRONMENT=local and this
# marker enabled for an isolated local diagnostic.
# API_TRACING_DIAGNOSTIC_MODE="true"
# API_TRACING_SAMPLE_RATE="1"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://alloy:4318"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://alloy:4318/v1/traces"

# Environment
NODE_ENV="development"
# Deployment identity used by logs and operational telemetry. Unlike NODE_ENV,
# this remains "staging" for staging deployments that run in production mode.
DEPLOYMENT_ENVIRONMENT="development"

# Disabled-by-default rollout gate for canonical PLAN -> PLAN_STAGE -> STANDARD
# production. Enable only after the matching API, OpenAPI, UI Common, and CLI
# compatibility builds are deployed and legacy Temporal workers remain pinned.
PLAN_WORK_ITEM_CANONICAL_PRODUCER_ENABLED=false

# Closed-by-default FEATURE requirements registry cutover placeholders. Set
# these only for the coordinated maintenance command after every project has
# an approved conversion run and old consumers are stopped.
FEATURE_REQUIREMENTS_BINDING_AUTHORIZED=false
FEATURE_REQUIREMENTS_OLD_CONSUMERS_STOPPED=false
FEATURE_REQUIREMENTS_CONSUMER_RELEASE=""
FEATURE_REQUIREMENTS_BINDING_SCOPE=""

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# LLM Configuration
# Provider selection: claude, openai, synthetic, or local
LLM_PROVIDER="claude"

# External LLM Service (when using microservice architecture)
LLM_EXTERNAL=false
LLM_SERVICE_URL="http://localhost:8000"
LLM_TIMEOUT=120000
EMBEDDINGS_SERVICE_URL="http://localhost:8001"

# Claude/Anthropic Configuration (when LLM_PROVIDER=claude)
CLAUDE_API_KEY="your-claude-api-key"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# OpenAI Configuration (when LLM_PROVIDER=openai)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_ORGANIZATION=""

# Explicit test-only provider routing. When enabled outside production, both
# provider base URLs must target MOCK_LLM_SERVER_URL before X-Mock-Session is
# accepted or forwarded.
MOCK_LLM_SESSION_ROUTING_ENABLED=false
MOCK_LLM_SERVER_URL="http://localhost:3001"

# Antrhopic Configuration (when LLM_PROVIDER=anthropic)
CLAUDE_API_KEY=""

# Synthetic Configuration (when LLM_PROVIDER=synthetic)
SYNTHETIC_LLM_API_KEY="your-synthetic-api-key"
SYNTHETIC_BASE_URL_OPENAI="https://api.synthetic.new/openai/v1"
SYNTHETIC_BASE_URL_ANTHROPIC="https://api.synthetic.new/anthropic"
SYNTHETIC_MODEL="hf:deepseek-ai/DeepSeek-V3.2"

# Local LLM Configuration (when LLM_PROVIDER=local or LLM_LOCAL_ENABLED=true)
# Note: Local LLM is disabled in production environments
LLM_LOCAL_ENABLED=false
LLM_LOCAL_URL=http://192.168.50.212:11434
LLM_LOCAL_MODEL=llama3.2:3b
LLM_LOCAL_TIMEOUT=120000

# Mastra.ai Agent Configuration
# Base URL for Mastra.ai API (set to local server for development)
MASTRA_BASE_URL="http://localhost:4112/api"
# Timeout for agent execution (default: 300000ms = 5 minutes)
MASTRA_TIMEOUT=300000
# Circuit breaker threshold for agent failures (default: 5)
MASTRA_CIRCUIT_BREAKER_THRESHOLD=5
# Maximum concurrent agent executions (default: 10)
MASTRA_MAX_CONCURRENT_EXECUTIONS=10

# Organization-Scoped API Keys:
# - Each organization automatically gets its own Mastra.ai API key on creation
# - Keys are securely stored in the database with proper encryption
# - Cross-organization isolation is enforced at the API key level
# - Keys are cached for performance with automatic TTL expiry

# Topology Cron
# Set to "true" to disable the topology consolidation cron (runs in deployed env)
DISABLE_TOPOLOGY_CRON="false"

# Resend (transactional email)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_ADDRESS="onboarding@yourdomain.com"
# Durable private-beta access request notifications are sent to this operator address.
PRIVATE_BETA_ACCESS_OPERATOR_EMAIL="operator@yourdomain.com"
# Public URL of the web app, used to build sign-in links in transactional emails (no trailing slash)
WEB_APP_URL="http://localhost:3000"

# Example configurations:
# For Claude API direct: LLM_PROVIDER=claude, LLM_EXTERNAL=false, CLAUDE_API_KEY=sk-ant-...
# For OpenAI API direct: LLM_PROVIDER=openai, OPENAI_API_KEY=sk-...
# For Synthetic API direct: LLM_PROVIDER=synthetic, SYNTHETIC_LLM_API_KEY=...
# For local development: LLM_PROVIDER=local, LLM_LOCAL_ENABLED=true
# For external LLM service: LLM_PROVIDER=claude, LLM_EXTERNAL=true, LLM_SERVICE_URL=...

# Demo sandbox admission
# Cloudflare Turnstile secret used to verify bot-check tokens server-side
DEMO_BOT_CHECK_SECRET=""
# Key for hashing creator addresses used by the per-address creation limit
DEMO_IP_HASH_KEY=""
# Seconds of inactivity after which a demo sandbox expires and is deleted (default 7200)
DEMO_SANDBOX_INACTIVITY_TIMEOUT_SECONDS=7200
