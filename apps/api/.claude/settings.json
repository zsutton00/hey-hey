{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r .tool_input.file_path); [ -f \"$f\" ] && \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier --write --ignore-unknown \"$f\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
