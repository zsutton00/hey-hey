{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": true,
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "paths": {
      "src/*": ["./src/*"],
      "@hey-hey/contracts/api/models": [
        "../../packages/contracts/dist/cjs/generated/api/models/index.d.ts"
      ],
      "@hey-hey/contracts/api/custom/*": [
        "../../packages/contracts/dist/cjs/generated/api/custom/*"
      ],
      "@hey-hey/contracts/agent-bridge/models": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/models/index.d.ts"
      ],
      "@hey-hey/contracts/agent-bridge/custom/*": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/custom/*"
      ],
      "@hey-hey/contracts/agent-bridge/runtime-schema": [
        "../../packages/contracts/dist/cjs/generated/agent-bridge/repository-feature-enrichment-runtime-schema.d.ts"
      ],
      "@hey-hey/contracts/brands": [
        "../../packages/contracts/dist/cjs/brands.d.ts"
      ]
    }
  },
  "include": ["src/**/*"]
}
