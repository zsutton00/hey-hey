{
  "$id": "/schemas/mcp-operation-input/v1.0.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpOperationInputV1_0_0",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "changes", "metadata"],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "initiativeId": {
          "type": "string",
          "minLength": 1
        },
        "planId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "ref"],
        "properties": {
          "entityType": {
            "type": "string",
            "enum": ["initiative", "plan", "task"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeType", "target", "value"],
        "properties": {
          "changeType": {
            "type": "string",
            "enum": ["replace", "update", "add", "remove"]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:\\$?\\.)?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])*)$"
          },
          "value": true,
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestorId", "correlationId", "intent", "timestamp"],
      "properties": {
        "requestorId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
