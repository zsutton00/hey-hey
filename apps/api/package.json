{
  "name": "hey-hey-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "nest build",
    "prebuild": "pnpm run clean && pnpm prisma generate",
    "clean": "node -e \"const fs=require('fs');try{fs.rmSync('dist',{recursive:true,force:true});}catch(e){if(e.code!=='ENOENT')throw e;}\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "node scripts/run-dev.js",
    "dev:with-worker": "concurrently --kill-others-on-fail \"pnpm dev\" \"pnpm run worker:dev\" --names \"api,worker\" --prefix-colors \"blue,green\"",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "worker:dev": "nodemon --watch src --ext ts --exec 'ts-node -r tsconfig-paths/register' src/worker.ts",
    "stats": "nest build --stats-json",
    "start": "nest start",
    "prestart": "pnpm prisma generate",
    "start:debug": "pnpm run kill && TEMPORAL_DEBUG=true nest start --debug --watch",
    "kill": "node scripts/stop-dev.js",
    "kill:tests": "bash scripts/kill-test-procs.sh",
    "start:prod": "node dist/main",
    "filter-logs": "node filter-logs.js",
    "email:preview-welcome": "ts-node -r tsconfig-paths/register scripts/preview-welcome-email.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:changed": "jest --changedSince=HEAD --passWithNoTests",
    "test:changed:branch": "jest --changedSince=origin/main --passWithNoTests",
    "test:file": "jest --runTestsByPath",
    "test:related": "jest --findRelatedTests --passWithNoTests",
    "test:non-func": "jest --testPathIgnorePatterns=\".*\\.functional\\.test\\.ts$\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --testPathIgnorePatterns=\".*\\.functional\\.test\\.ts$\"",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --testPathIgnorePatterns=\".*\\.workflow\\.test\\.ts$\"",
    "test:func": "jest functional.test --runInBand",
    "test:func-cov": "jest functional.test --coverage --runInBand",
    "test:all": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:api": "node scripts/with-model-generation-lock.js -- pnpm run generate:api:unlocked",
    "generate:api:unlocked": "node scripts/generate-api-atomically.js",
    "generate:api:force": "HEY_HEY_FORCE_OPENAPI_GENERATION=1 pnpm generate:api",
    "generate:agents": "node scripts/with-model-generation-lock.js -- pnpm run generate:agents:unlocked",
    "generate:agents:unlocked": "node scripts/generate-openapi-models.js agents-models agents && node scripts/post-process-agents-types.js && prettier --write src/generated/agents",
    "generate:local": "node scripts/with-model-generation-lock.js -- pnpm run generate:local:unlocked",
    "generate:local:unlocked": "node scripts/generate-openapi-models.js local-models agent-bridge && node scripts/post-process-local-types.js && prettier --write src/generated/local && pnpm run generate:repository-feature-enrichment-runtime-schema",
    "generate:repository-feature-enrichment-runtime-schema": "node scripts/generate-repository-feature-enrichment-runtime-schema.js && prettier --write src/contracts/repository-feature-enrichment-runtime-schema.ts",
    "generate:embeddings": "node scripts/with-model-generation-lock.js -- pnpm run generate:embeddings:unlocked",
    "generate:embeddings:unlocked": "node scripts/generate-embeddings-types.js && prettier --write src/generated/embeddings",
    "generate:graphs": "node scripts/with-model-generation-lock.js -- pnpm run generate:graphs:unlocked",
    "generate:graphs:unlocked": "node scripts/generate-graphs-types.js && prettier --write src/generated/graphs",
    "generate:report-schemas": "node scripts/with-model-generation-lock.js -- pnpm run generate:report-schemas:unlocked",
    "generate:report-schemas:unlocked": "node scripts/generate-report-schemas.js && prettier --write src/mcp/tools/report-schemas.generated.ts",
    "generate:all": "node scripts/with-model-generation-lock.js -- pnpm run generate:all:unlocked",
    "generate:all:unlocked": "pnpm run generate:api:unlocked && pnpm run generate:agents:unlocked && pnpm run generate:local:unlocked && pnpm run generate:embeddings:unlocked && pnpm run generate:graphs:unlocked && pnpm run generate:report-schemas:unlocked",
    "generate:path-constants": "node scripts/with-model-generation-lock.js -- pnpm run generate:path-constants:unlocked",
    "generate:path-constants:unlocked": "node scripts/generate-path-constants.js",
    "generate:event-schemas": "node scripts/with-model-generation-lock.js -- pnpm run generate:event-schemas:unlocked",
    "generate:event-schemas:unlocked": "node scripts/generate-event-schemas.js",
    "verify:deploy": "pnpm generate:all && pnpm db:flyway:migrate && pnpm typecheck && pnpm test:all && pnpm build",
    "db:seed": "bash scripts/worktree-exec.sh prisma db seed",
    "db:seed:help": "bash scripts/worktree-exec.sh ts-node -r tsconfig-paths/register scripts/seed-help-content.ts",
    "db:generate": "node scripts/with-model-generation-lock.js -- pnpm run db:generate:unlocked",
    "db:generate:unlocked": "prisma generate && npx ts-node scripts/post-process-generated-types.ts",
    "db:backup": "bash scripts/worktree-exec.sh bash scripts/backup-db.sh",
    "db:backup:pre-migration": "bash scripts/worktree-exec.sh bash scripts/backup-db.sh pre-migration",
    "db:restore": "bash scripts/worktree-exec.sh bash scripts/restore-db.sh",
    "db:list-backups": "bash scripts/list-backups.sh",
    "worktree:context": "node -r ts-node/register/transpile-only scripts/worktree-db.ts context",
    "worktree:doctor": "node -r ts-node/register/transpile-only scripts/worktree-db.ts doctor",
    "worktree:exec": "bash scripts/worktree-exec.sh",
    "migration-stack": "bash scripts/migration-stack.sh",
    "db:worktree:ensure": "node -r ts-node/register/transpile-only scripts/worktree-db.ts ensure",
    "db:worktree:prepare": "node -r ts-node/register/transpile-only scripts/worktree-db.ts prepare",
    "db:worktree:status": "node -r ts-node/register/transpile-only scripts/worktree-db.ts status",
    "db:worktree:drop": "node -r ts-node/register/transpile-only scripts/worktree-db.ts drop",
    "db:flyway:info": "bash scripts/worktree-flyway.sh info",
    "db:flyway:validate": "bash scripts/worktree-flyway.sh validate",
    "db:flyway:migrate": "bash scripts/worktree-flyway.sh migrate",
    "db:flyway:baseline": "bash scripts/worktree-flyway.sh baseline",
    "events:replay": "bash scripts/worktree-exec.sh ts-node -r tsconfig-paths/register scripts/replay-events-to-embeddings.ts",
    "account-closure:run": "bash scripts/worktree-exec.sh ts-node -r tsconfig-paths/register scripts/run-account-closure.ts",
    "webhook:dev": "bash scripts/start-webhook-dev.sh",
    "webhook:test": "bash scripts/test-webhook.sh",
    "synthetic:sweep": "ts-node synthetic-test-suite/synthetic-sweep.ts",
    "performance:api-diagnostic": "node scripts/k6/run-api-diagnostic.mjs",
    "performance:api-activity": "node scripts/k6/launch-api-diagnostic.mjs",
    "performance:api-activity:seed": "node scripts/k6/seed-activity-fixture.mjs",
    "typesafe:jev:smoke": "ts-node -r tsconfig-paths/register scripts/typesafe-jev-smoke.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@elastic/elasticsearch": "8.11.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.2",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.2",
    "@octokit/graphql": "^9.0.1",
    "@octokit/rest": "^22.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@prisma/client": "^6.7.0",
    "@prisma/instrumentation": "6.17.1",
    "@rekog/mcp-nest": "^1.9.6",
    "@simplewebauthn/server": "^13.3.2",
    "@temporalio/activity": "^1.12.1",
    "@temporalio/client": "^1.11.8",
    "@temporalio/worker": "^1.11.8",
    "@temporalio/workflow": "^1.11.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/js-yaml": "^4.0.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cls-hooked": "^4.2.2",
    "commander": "^14.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "inquirer": "^12.9.3",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.13.1",
    "jsonriver": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.93",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "node-rsa": "^1.1.1",
    "openai": "^5.21.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.74",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@temporalio/testing": "^1.11.8",
    "@types/cls-hooked": "^4.3.9",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.7",
    "@types/node-rsa": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-mock": "^30.2.0",
    "lint-staged": "^16.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "prisma": "^6.7.0",
    "redis-memory-server": "^0.12.1",
    "redis-mock": "^0.56.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-json-schema-generator": "^1.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "maxWorkers": 4,
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@octokit/rest$": "<rootDir>/__mocks__/octokit-rest.ts",
      "^@octokit/graphql$": "<rootDir>/__mocks__/octokit-graphql.ts",
      "^@octokit/webhooks$": "<rootDir>/__mocks__/octokit-webhooks.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "lint-staged": {
    "*.{ts,json,md}": "prettier --write --ignore-unknown"
  }
}
